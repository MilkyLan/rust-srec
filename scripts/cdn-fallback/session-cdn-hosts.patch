+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn session_cdn_hosts_merge_all_candidates_across_reconnects() {
+    let fake = FakePlatform::start().await;
+    let room = fake.room("cdn-hosts");
+    // These candidates are blacklisted so only the loopback stream is ever fetched.
+    room.set_live(
+        room.live("First extraction")
+            .stream(json!({"url": "https://PULL-FLV-Q13.douyincdn.com:8443/live.flv?token=test", "quality": "origin"}))
+            .stream(json!({"url": "http://pull-flv-q13.douyincdn.com./audio.m3u8", "quality": "audio"})),
+    );
+    let app = TestApp::start_with(Seed::live().global("offline_check_delay_ms", 4_000)).await;
+    let token = app.admin_token().await;
+    let id = app
+        .watch(
+            &token,
+            "CDN hosts",
+            &room,
+            json!({"stream_selection_config": {"blacklisted_cdns": ["douyincdn.com"]}}),
+        )
+        .await;
+
+    room.wait_for_media_connection(1).await;
+    let session_id = only_session(&app, &token, &id).await;
+    assert_eq!(
+        app.session(&token, &session_id).await["cdn_hosts"],
+        json!(["127.0.0.1", "pull-flv-q13.douyincdn.com"])
+    );
+
+    room.set_live(
+        room.live("Second extraction")
+            .stream(json!({"url": "https://pull-flv-q14.douyincdn.com/live.flv"})),
+    );
+    room.reset();
+    room.wait_for_media_connection(2).await;
+    let sessions = app.sessions(&token, &id).await;
+    assert_eq!(sessions.len(), 1);
+    assert_eq!(sessions[0]["id"], session_id);
+    assert_eq!(
+        sessions[0]["cdn_hosts"],
+        json!([
+            "127.0.0.1",
+            "pull-flv-q13.douyincdn.com",
+            "pull-flv-q14.douyincdn.com"
+        ])
+    );
+
+    app.shutdown().await;
+}
