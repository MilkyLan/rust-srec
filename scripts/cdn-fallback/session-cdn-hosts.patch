diff --git a/crates/platforms/src/media.rs b/crates/platforms/src/media.rs
index aa7a3a0..63679eb 100644
--- a/crates/platforms/src/media.rs
+++ b/crates/platforms/src/media.rs
@@ -5,3 +5,18 @@ pub mod stream_info;
 pub use formats::{MediaFormat, StreamFormat};
 pub use media_info::MediaInfo;
 pub use stream_info::StreamInfo;
+
+/// Collect unique hostnames from stream URLs without retaining user info, ports, or signed paths.
+pub fn cdn_hosts<'a>(urls: impl IntoIterator<Item = &'a str>) -> Vec<String> {
+    let mut hosts: Vec<_> = urls
+        .into_iter()
+        .filter_map(|url| url::Url::parse(url).ok())
+        .filter_map(|url| {
+            let host = url.host_str()?.trim_end_matches('.');
+            (!host.is_empty()).then(|| host.to_ascii_lowercase())
+        })
+        .collect();
+    hosts.sort_unstable();
+    hosts.dedup();
+    hosts
+}
