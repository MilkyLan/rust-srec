+        let detector = StreamDetector::new();
+        let config = StreamSelectionConfig {
+            blacklisted_cdns: vec!["blocked.example.com".into()],
+            ..Default::default()
+        };
+        let douyin_url = "https://live.douyin.com/12345";
+        let mut blocked = create_test_stream();
+        blocked.url = "https://blocked.example.com/stream.flv".into();
+        let allowed = create_test_stream();
+        let mut blocked_opt_in = blocked.clone();
+        blocked_opt_in.format_opt_in = true;
+        let streamer =
+            StreamerMetadata::from_db_model(&crate::database::models::StreamerDbModel::new(
+                "fixture",
+                douyin_url,
+                "fixture-platform",
+            ));
+
+        let blocked_check = || (Some(true), vec![blocked.clone()], None);
+        let mut checks = vec![
+            blocked_check(),
+            blocked_check(),
+            (
+                Some(true),
+                vec![blocked.clone(), allowed.clone()],
+                Some(allowed.url.as_str()),
+            ),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            (Some(false), Vec::new(), None),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            (None, Vec::new(), None),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            blocked_check(),
+            (Some(true), vec![blocked_opt_in], None),
+        ];
+        checks.extend((0..4).map(|_| blocked_check()));
+        let mut final_blocked = blocked.clone();
+        final_blocked.url = "https://blocked.example.com/fresh.flv".into();
+        checks.push((
+            Some(true),
+            vec![final_blocked.clone()],
+            Some(final_blocked.url.as_str()),
+        ));
+
+        for (is_live, streams, expected) in checks {
+            let media = is_live
+                .map(|is_live| {
+                    platforms_parser::media::MediaInfo::builder(douyin_url, "fixture", "fixture")
+                        .is_live(is_live)
+                        .streams(streams)
+                        .build()
+                })
+                .ok_or_else(|| ExtractorError::Other("fixture extraction failure".into()));
+            let extractor =
+                FakeExtractor::new(media, expected.map(|_| Ok(())).into_iter().collect());
+            if is_live.is_none() {
+                assert!(
+                    detector
+                        .check_status_with_extractor(&streamer, Some(&config), &extractor)
+                        .await
+                        .is_err()
+                );
+                continue;
+            }
+            let result = detector
+                .check_status_with_extractor(&streamer, Some(&config), &extractor)
+                .await
+                .unwrap();
+            match (result, expected) {
+                (LiveStatus::Live { streams, .. }, Some(url)) => {
+                    assert_eq!(streams[0].url, url);
+                }
+                (LiveStatus::Offline, None) => {}
+                (status, _) => panic!("unexpected detection status: {status:?}"),
+            }
+        }
+    }
